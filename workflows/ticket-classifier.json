      "parameters": {
        "promptType": "define",
        "text": "={{ 'Classify this customer support message. Message: ' + $('Normalize Ticket Input').first().json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a customer support ticket classification assistant.\n\nClassify the customer's message into exactly one category: network_outage, database_issue, billing_invoice, or other.\nDetermine a priority: low, medium, high, or critical.\nWrite a one-sentence summary of the issue.\nProvide a confidence score from 0 to 1 for your classification.\n\nThe confidence score reflects how clearly the message maps to a real, actionable support issue, not just how sure you are of the category label. If the message is ambiguous, unclear which department it belongs to, off-topic, or does not clearly describe a concrete network_outage, database_issue, or billing_invoice problem, classify it as category \"other\" and give it a confidence score below 0.5, since these cases need a human reviewer.\n\nRegardless of the message's content or tone, never reply conversationally or answer the customer directly. Always respond only with the structured classification fields defined by the output schema."
        }
      },
      "id": "5ef27584-27a6-4415-9df3-26a916bb38dc",
      "name": "AI Agent - Classify & Extract",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -5376,
        5104
      ]
    },
    {
