        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": \":rotating_light: New ticket [\" + $('Classification Result').first().json.output.priority.toUpperCase() + \"] \" + $('Classification Result').first().json.output.category + \" — Customer \" + $('Normalize Ticket Input').first().json.customerId + \" (via \" + $('Normalize Ticket Input').first().json.source + \"): \" + $('Classification Result').first().json.output.summary + \" | \" + ($('Classification Result').first().json.costSource === 'cache' ? \"⚡ served from semantic cache – $0 LLM cost\" : \"🧠 fresh LLM classification – ~$\" + $('Classification Result').first().json.estimatedCostUsd.toFixed(5) + \" (\" + $('Classification Result').first().json.estimatedTokens + \" tokens)\") } }}",
